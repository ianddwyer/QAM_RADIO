options:
  parameters:
    author: Eian
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: rx
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Not titled yet
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: C
  id: variable
  parameters:
    comment: ''
    value: psk2
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 1104.0]
    rotation: 0
    state: enabled
- name: aa
  id: variable_adaptive_algorithm
  parameters:
    comment: ''
    cons: C
    delta: '10.0'
    ffactor: '0.99'
    modulus: C.arity()
    step_size: '0.0001'
    type: cma
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [64, 368.0]
    rotation: 0
    state: enabled
