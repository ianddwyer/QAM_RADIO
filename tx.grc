- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "# -*- coding: utf-8 -*-\n\"\"\"\nCreated on Tue Apr 15 02:21:22\
      \ 2025\n\n@author: Eian\n\"\"\"\n\nimport numpy\nfrom gnuradio import gr\n\n\
      class tag_counter_block(gr.sync_block):\n    def __init__(self,rxflag=0):\n\
      \        gr.sync_block.__init__(\n            self, \n            name=\"Tag\
      \ Counter\",\n            in_sig=[numpy.float32], \n            out_sig=[numpy.float32])\n\
      \        self.tag_count = 0\n        self.rxflag = 0\n\n    def work(self, input_items,\
      \ output_items):\n        \n        tags = self.get_tags_in_window(0, 0, len(input_items[0]))#\
      \ Get tags in the current work call\n        self.tag_count += len(tags)*self.rxflag#\
      \ Count the tags\n        output_items[0][:] = self.tag_count # Pass data through\n\
      \        return len(output_items[0]) #return length of output for tag ref\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: int(2e6)
    minoutbuf: '0'
    rxflag: rxstartflag
  states:
    _io_cache: ('Tag Counter', 'tag_counter_block', [('rxflag', '0')], [('0', 'float',
      1)], [('0', 'float', 1)], '', ['rxflag'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2960, 1792.0]
    rotation: 0
    state: disabled
- name: epy_block_2
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        gr.sync_block.__init__(\n            self,\n\
      \            name=\"PrintBytes\",         # Block name\n            in_sig=[np.uint8],\
      \         # Input stream of bytes\n            out_sig=[]                 #\
      \ No output\n        )\n\n    def work(self, input_items, output_items):\n \
      \       in0 = input_items[0]\n\n        # Print incoming bytes as list of integers\n\
      \        print(\"Received Bytes:\", list(in0))\n\n        # Optional: Print\
      \ as hex\n        # print(\"Hex:\", [hex(b) for b in in0])\n\n        return\
      \ len(in0)\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('PrintBytes', 'blk', [], [('0', 'byte', 1)], [], '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2968, 888.0]
    rotation: 0
    state: disabled
